#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                          &kp Q     &kp W     &kp E     &kp R     &kp T            &kp Y      &kp U      &kp I     &kp O     &kp P
                &kp TAB   &kp A     &kp S     &kp D     &kp F     &kp G            &kp H      &kp J      &kp K     &kp L     &kp SEMI  &kp SQT
                &kp DEL   &kp Z     &kp X     &kp C     &kp V     &kp B            &kp N      &kp M      &kp COMMA &kp DOT   &kp SLASH &kp BSLH
                                    &mo 1 &lt 2 RET &mt LCTRL ESC &kp LALT         &mt LGUI RET &mt LSHFT SPACE &lt 3 SPACE &kp BSPC
            >;
        };
        mouse {
            bindings = <
                          &kp F2    &kp F3    &kp F4    &kp F5    &kp F6            &kp F7    &kp F8     &kp F9    &kp F10   &kp F11
                &kp F1    &mkp MB4  &kp trans &mkp MCLK &mkp LCLK &mkp RCLK         &mmv MOVE_LEFT &mmv MOVE_DOWN  &mmv MOVE_UP &mmv MOVE_RIGHT &mkp MB5 &kp F12
                &kp trans &kp trans &kp trans &kp trans &kp trans &kp trans         &kp trans &kp trans  &kp trans &kp trans &kp trans &kp trans
                                    &kp trans &kp trans &kp trans &kp trans         &kp trans &kp trans  &mo 4     &kp trans
            >;
        };
        special {
            bindings = <
                          &kp N1    &kp N2    &kp N3    &kp N4    &kp N5            &kp N6    &kp N7     &kp N8    &kp N9    &kp N0
                &kp HOME  &kp AMPS  &kp ASTRK &kp POUND &kp DLLR  &kp LPAR          &kp RPAR  &kp MINUS  &kp PLUS  &kp PSCRN &kp PRCNT &kp END
                &kp PG_UP &kp EXCL  &kp AT    &kp CARET &kp TILDE &kp LBKT          &kp RBKT  &kp UNDER  &kp EQUAL &kp trans &kp GRAVE &kp PG_DN
                                    &kp trans &kp trans &kp trans &kp trans         &kp trans &kp trans  &kp trans &kp trans
            >;
        };
        arrows {
            bindings = <
                          &kp trans &kp trans &kp trans &kp trans &kp trans         &kp trans &kp trans  &kp trans &kp trans &kp trans
                &kp trans &kp trans &kp trans &kp trans &kp trans &kp trans         &kp LEFT  &kp DOWN   &kp UP    &kp RIGHT &kp trans &kp trans
                &kp trans &kp trans &kp trans &kp trans &kp trans &kp trans         &kp trans &kp trans  &kp trans &kp trans &kp trans &kp trans
                                    &kp trans &kp trans &kp trans &kp trans         &kp trans &kp trans  &kp trans &kp trans
            >;
        };
        mouse_scroll {
            bindings = <
                          &kp F2    &kp F3    &kp F4    &kp F5    &kp F6            &kp F7    &kp F8     &kp F9    &kp F10   &kp F11
                &kp F1    &mkp MB4  &kp trans &mkp MCLK &mkp LCLK &mkp RCLK         &msc SCRL_LEFT &msc SCRL_DOWN  &msc SCRL_UP &msc SCRL_RIGHT &mkp MB5 &kp F12
                &kp trans &kp trans &kp trans &kp trans &kp trans &kp trans         &kp trans &kp trans  &kp trans &kp trans &kp trans &kp trans
                                    &kp trans &kp trans &kp trans &kp trans         &kp trans &kp trans  &kp trans &kp trans
            >;
        };
    };
};
