#include <zephyr/dt-bindings/gpio/gpio.h>
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "row2col";
        wakeup-source;

        row-gpios =
            <&pro_micro 18 GPIO_ACTIVE_HIGH>, // row_top
            <&pro_micro 15 GPIO_ACTIVE_HIGH>, // row_home
            <&pro_micro 14 GPIO_ACTIVE_HIGH>, // row_bottom
            <&pro_micro 19 GPIO_ACTIVE_HIGH>; // row_thumb

        col-gpios =
            <&pro_micro 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  // col_outer
            <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  // col_pinky
            <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  // col_ring
            <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  // col_middle
            <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  // col_index
            <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  // col_inner
            <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  // col_thumb_one
            <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  // col_thumb_two
            <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>, // col_thumb_three
            <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; // col_thumb_four
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        
        rows = <4>;
        columns = <22>;

        map = <
        // Row 0: upper finger keys
                     RC(0, 1) RC(0, 2) RC(0, 3) RC(0, 4) RC(0, 5)    RC(0, 15) RC(0, 14) RC(0, 13) RC(0, 12) RC(0, 11)
        // Row 1: home finger keys
            RC(1, 0) RC(1, 1) RC(1, 2) RC(1, 3) RC(1, 4) RC(1, 5)    RC(1, 15) RC(1, 14) RC(1, 13) RC(1, 12) RC(1, 11) RC(1, 10)
        // Row 2: lower finger keys
            RC(2, 0) RC(2, 1) RC(2, 2) RC(2, 3) RC(2, 4) RC(2, 5)    RC(2, 15) RC(2, 14) RC(2, 13) RC(2, 12) RC(2, 11) RC(2, 10)
        // Row 3: thumb keys
                              RC(3, 6) RC(3, 7) RC(3, 8) RC(3, 9)    RC(3, 19) RC(3, 18) RC(3, 17) RC(3, 16)
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        kscan = <&kscan0>;
        transform = <&default_transform>;
    };

    chosen {
        zmk,physical-layout = <&physical_layout0>;
    };
};
